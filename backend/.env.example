# Copy to .env and fill in. `.env` is gitignored — never commit real keys.

# LLM provider (nan.builders, OpenAI-compatible). Server-side only.
NAN_API_KEY=
NAN_BASE_URL=https://api.nan.builders/v1
NAN_MODEL=deepseek-v4-flash
NAN_REASONING_EFFORT=low

# Upload guard
MAX_UPLOAD_MB=50

# Frontend origin allowed by CORS
CORS_ORIGINS=["http://localhost:4200"]

# Rate limiting (RF8): fixed window inside the API process, per client and per endpoint
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_ANALYZE=120
RATE_LIMIT_REPORT=60
RATE_LIMIT_PDF=30
