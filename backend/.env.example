# Copy to .env and fill in. `.env` is gitignored — never commit real keys.

# LLM provider (nan.builders, OpenAI-compatible). Server-side only.
NAN_API_KEY=
NAN_BASE_URL=https://api.nan.builders/v1
NAN_MODEL=deepseek-v4-flash
NAN_REASONING_EFFORT=low

# Upload guard
MAX_UPLOAD_MB=50

# Frontend origin allowed by CORS
CORS_ORIGINS=["http://localhost:4200"]
